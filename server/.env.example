# ==========================================
# VARIABLES DE ENTORNO - SERVIDOR PERNSTORE
# ==========================================

# 1. Puerto del servidor (Render lo asigna automáticamente)
PORT=4000

# 2. Base de Datos PostgreSQL
# En Supabase o Neon: connection string directa con sslmode=require
DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@[TU_HOST_SUPABASE]:5432/postgres

# O en desarrollo local (opcional si usas variables individuales):
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pernstore

# 3. Seguridad JWT
JWT_SECRET=super_clave_secreta_para_firmar_tokens_jwt_pernstore_2026

# 4. Inteligencia Artificial (Google Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini

# 5. URL del Frontend desplegado (para habilitar CORS en producción)
CLIENT_URL=https://tu-proyecto.vercel.app
